// Prisma Schema for Multi-User DocVault
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String?
  image        String?
  isAdmin      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  documents    Document[]
  userSettings UserSettings?
  activityLogs ActivityLog[]
}

model AuthorizedEmail {
  id           String   @id @default(cuid())
  email        String   @unique
  addedByAdmin String
  addedAt      DateTime @default(now())
  hasLoggedIn  Boolean  @default(false)
}

model Document {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     String
  tags         String[]
  notes        String?
  fileKey      String    // Cloudinary public_id, NOT a public URL
  fileType     String
  expiryDate   DateTime?
  reminderSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderThresholds Int[]    @default([30, 60, 90])
  updatedAt          DateTime @updatedAt
}

model ReminderLog {
  id         String   @id @default(cuid())
  documentId String
  sentAt     DateTime @default(now())
  daysBefore Int
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}
