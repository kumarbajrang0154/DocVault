# Mood Environment Variables Example
# Copy this file to .env.local for local development.

# Google OAuth Credentials (from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth Secret Key for session signing
AUTH_SECRET=

# Database Connection URL (PostgreSQL / SQLite string)
DATABASE_URL=

# AI & External Metadata Providers
YOUTUBE_API_KEY=
OPENAI_API_KEY=

# Internal Cron Secret for Background Job Endpoints
CRON_SECRET=

# Cloudflare R2 Storage Credentials & Configuration
# Cloudflare Account ID (found in Cloudflare dashboard overview)
R2_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare R2 Access Key ID (generated under R2 API Tokens)
R2_ACCESS_KEY_ID=your_r2_access_key_id

# Cloudflare R2 Secret Access Key (generated under R2 API Tokens)
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Cloudflare R2 Bucket Name
R2_BUCKET_NAME=your_r2_bucket_name

# Cloudflare R2 Public Domain / Base URL (e.g. https://pub-xxxx.r2.dev or custom domain)
R2_PUBLIC_URL_BASE=https://your-public-r2-domain.com


