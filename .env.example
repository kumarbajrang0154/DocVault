# Mood Environment Variables Example
# Copy this file to .env.local for local development.

# Google OAuth Credentials (from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth Secret Key for session signing
AUTH_SECRET=

# Database Connection URL (PostgreSQL / SQLite string)
DATABASE_URL=

# AI & External Metadata Providers
YOUTUBE_API_KEY=
OPENAI_API_KEY=

# Internal Cron Secret for Background Job Endpoints
CRON_SECRET=

