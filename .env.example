# DocVault Environment Variables Example
# Copy this file to .env.local for local development.

# Google OAuth Credentials (from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# NextAuth Secret Key for session signing
AUTH_SECRET=your_auth_secret_key

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/docvault?schema=public"

# AES-256 Server-Side Encryption Key (32-byte secret string or passphrase)
DOC_ENCRYPTION_KEY=your_32_byte_secret_encryption_key

# Cloudinary Private Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Internal Cron Secret for Vercel Cron Endpoints
CRON_SECRET=your_cron_secret
